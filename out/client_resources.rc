#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

// Original PE resources are represented as normal source assets.  The two
// bitmap controls intentionally keep numeric resource identities because the
// dialog manager loads them by ordinal from the STATIC/SS_BITMAP controls.

LANGUAGE LANG_NEUTRAL, SUBLANG_DEFAULT
IDB_SFERA_BRAND BITMAP "resources\\sfera_brand.bmp"

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
IDB_SPHERE_BRAND BITMAP "resources\\sphere_brand.bmp"

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
IDI_SPHERECLIENT ICON "resources\\sphereclient.ico"

LANGUAGE LANG_NEUTRAL, SUBLANG_DEFAULT
IDD_CONNECTION DIALOGEX 0, 0, 282, 311, 0
STYLE 0x90C808C0
EXSTYLE 0x00000000
CAPTION "Подключение"
FONT 8, "MS Sans Serif", 0, 0, 0
BEGIN
    CONTROL "", IDC_USERNAME_EDIT, EDIT, 0x50810080, 88, 150, 100, 12
    CONTROL "", IDC_PASSWORD_EDIT, EDIT, 0x508100A0, 88, 166, 100, 12
    CONTROL "Сохранить пароль", IDC_SAVE_PASSWORD, BUTTON, 0x50010003, 88, 183, 96, 10
    CONTROL "OK", IDC_LOGIN, BUTTON, 0x50010001, 193, 150, 56, 13
    CONTROL "Отмена", IDC_CANCEL_LOGIN, BUTTON, 0x50010000, 193, 166, 56, 12
    CONTROL "", IDC_SERVER_LIST, LISTBOX, 0x50A04101, 7, 248, 268, 55
    CONTROL "", -1, BUTTON, 0x50000007, 7, 141, 268, 57
    CONTROL "Имя пользователя:", IDC_USERNAME_LABEL, STATIC, 0x50020002, 15, 151, 67, 8
    CONTROL "Пароль:", IDC_PASSWORD_LABEL, STATIC, 0x50020002, 14, 167, 68, 8
    CONTROL IDB_SFERA_BRAND, IDC_SFERA_BRAND, STATIC, 0x5000180E, 8, 7, 268, 130
    CONTROL IDB_SPHERE_BRAND, IDC_SPHERE_BRAND, STATIC, 0x5000100E, 7, 7, 268, 130
    CONTROL "Загружать новые земли", IDC_STREAM_OPTION_1, BUTTON, 0x50010003, 22, 206, 151, 10
    CONTROL "Загружать новые земли", IDC_STREAM_OPTION_2, BUTTON, 0x50010003, 22, 218, 131, 10
    CONTROL "Загружать новые земли", IDC_STREAM_OPTION_3, BUTTON, 0x50010003, 22, 230, 244, 10
    CONTROL "", -1, BUTTON, 0x50000007, 7, 198, 268, 46
    CONTROL "Регистрация", IDC_REGISTER, BUTTON, 0x50010000, 193, 181, 56, 13
END

LANGUAGE LANG_NEUTRAL, SUBLANG_DEFAULT
IDD_UPDATE DIALOG 0, 0, 282, 207
STYLE 0x90C808C0
EXSTYLE 0x00000000
CAPTION "Обновление"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL IDB_SFERA_BRAND, IDC_SFERA_BRAND, STATIC, 0x5000100E, 7, 7, 268, 130
    CONTROL "", -1, BUTTON, 0x50000007, 7, 141, 268, 59
    CONTROL "Progress1", IDC_UPDATE_PROGRESS_CURRENT, "msctls_progress32", 0x50800001, 16, 161, 250, 8
    CONTROL "Progress1", IDC_UPDATE_PROGRESS_TOTAL, "msctls_progress32", 0x50800001, 16, 183, 250, 8
    CONTROL "Static", IDC_UPDATE_CURRENT_TEXT, STATIC, 0x50020000, 16, 151, 215, 8
    CONTROL "Всего:", IDC_UPDATE_TOTAL_LABEL, STATIC, 0x50020000, 16, 172, 23, 8
    CONTROL "100%", IDC_UPDATE_CURRENT_PERCENT, STATIC, 0x50020002, 239, 151, 26, 8
    CONTROL "100%", IDC_UPDATE_TOTAL_PERCENT, STATIC, 0x50020002, 239, 172, 26, 8
    CONTROL IDB_SPHERE_BRAND, IDC_SPHERE_BRAND, STATIC, 0x5000100E, 7, 7, 268, 130
END

LANGUAGE LANG_NEUTRAL, SUBLANG_DEFAULT
1 RT_MANIFEST "resources\\sphereclient.manifest"
